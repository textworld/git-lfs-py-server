# ===== Git LFS Server =====
# 对外可访问的基础 URL（Git 客户端会通过这个地址访问 LFS endpoint）
SERVER_BASE_URL=http://localhost:8000

# 存储到七牛云的对象前缀
STORAGE_PREFIX=lfs

# 单个对象最大字节数（默认 5GB，LFS 单文件上限）
MAX_OBJECT_SIZE=5368709120

# ===== HTTP Basic 认证 =====
# Git 客户端访问 LFS 时使用这对用户名密码
LFS_USER=lfs
LFS_PASSWORD=change-me-please

# ===== 七牛云配置 =====
# 在 https://portal.qiniu.com/user/key 获取
QINIU_ACCESS_KEY=your_access_key
QINIU_SECRET_KEY=your_secret_key

# 存储桶名
QINIU_BUCKET=your-bucket-name

# 存储桶域名（七牛云控制台 -> 对象存储 -> 域名管理）
# 形如 your-bucket.qiniucdn.com 或 your-bucket.bkt.clouddn.com
QINIU_BUCKET_DOMAIN=your-bucket.qiniucdn.com

# 私有空间需设置为 true；公开空间设为 false
QINIU_BUCKET_PRIVATE=true

# ===== 元数据 =====
# 记录每个 OID 的本地元数据（SQLite）
METADATA_DB_PATH=./lfs_metadata.db
